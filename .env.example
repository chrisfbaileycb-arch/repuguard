# RepuShield — Environment Variables
# Copy this file to .env and fill in your values before deploying.
# NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=https://your-domain.com

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-strong-jwt-secret-here

# ─── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=you@yourdomain.com
# Password for the seeded admin account (set before first deploy)
ADMIN_SEED_PASSWORD=ChangeThisBeforeDeploying!

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# If not set, falls back to local PGlite at /tmp/repushield-data
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_ / pk_test_ for development, sk_live_ / pk_live_ for production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in Stripe Dashboard > Products
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# ─── Frontend (Vite build-time) ───────────────────────────────────────────────
# Public Stripe key — safe to expose in browser
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
